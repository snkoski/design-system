{
  "name": "design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Tokens, styles, and React components for a playful, accessible design system.",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./tailwind-theme.css": "./dist/tailwind-theme.css",
    "./tokens.json": "./tokens/tokens.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "node scripts/build-tokens.mjs && storybook dev -p 6006",
    "storybook": "node scripts/build-tokens.mjs && storybook dev -p 6006",
    "build-storybook": "node scripts/build-tokens.mjs && storybook build",
    "build": "node scripts/build-tokens.mjs && vite build && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "node scripts/build-tokens.mjs && tsc --noEmit",
    "chromatic": "chromatic --exit-zero-on-changes",
    "prepare": "node scripts/build-tokens.mjs && vite build && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "test": "node scripts/build-tokens.mjs && vitest run",
    "test:unit": "node scripts/build-tokens.mjs && vitest run --project unit",
    "test:stories": "node scripts/build-tokens.mjs && vitest run --project storybook",
    "test:watch": "node scripts/build-tokens.mjs && vitest --project unit",
    "test:coverage": "node scripts/build-tokens.mjs && vitest run --coverage",
    "check": "node scripts/check-contrast.mjs && node scripts/check-rules.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:rules": "node scripts/check-rules.mjs",
    "check:tests": "node scripts/check-tests-kept.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "chromatic": "^18.12.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.55.0",
    "playwright": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.5"
  }
}
